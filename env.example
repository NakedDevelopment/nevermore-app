# Appwrite Configuration
# Your existing .env file should contain these variables:

# Appwrite Cloud Endpoint (or self-hosted URL)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID (get from Appwrite Console)
APPWRITE_PROJECT_ID=your_project_id_here

# Your Appwrite Database ID (for storing user data)
APPWRITE_DATABASE_ID=your_database_id_here

# Your Appwrite Category Collection ID
APPWRITE_CATEGORY_COLLECTION_ID=your_collection_id_here

# Your Appwrite Content Collection ID
# Collection must define transcriptRecoveryText & transcriptSupportText (large text) for in-app transcripts.
APPWRITE_CONTENT_COLLECTION_ID=your_content_collection_id_here

# Your Appwrite User Profiles Collection ID (REQUIRED for user registration)
APPWRITE_USER_PROFILES_COLLECTION_ID=your_user_profiles_collection_id_here

# Your Appwrite Support Collection ID (for support tickets)
APPWRITE_SUPPORT_COLLECTION_ID=your_support_collection_id_here

# Your Appwrite Settings Collection ID (for privacy policy and terms & conditions)
APPWRITE_SETTINGS_COLLECTION_ID=your_settings_collection_id_here

# Your Appwrite Invitations Collection ID (for friend invitations)
APPWRITE_INVITATIONS_COLLECTION_ID=your_invitations_collection_id_here

# Your Appwrite Storage Bucket ID (for audio and media files)
APPWRITE_STORAGE_BUCKET_ID=your_storage_bucket_id_here

# Your Appwrite Welcome Quote Collection ID (for welcome screen quotes)
APPWRITE_WELCOME_QUOTE_COLLECTION_ID=welcome_quote

# Your Appwrite Invitation Function ID (optional - for sending invitation emails)
# If not set, invitations will be saved but emails won't be sent
APPWRITE_INVITATION_FUNCTION_ID=your_invitation_function_id_here

# In-App Purchase product IDs (required for subscriptions to work; must match store configuration exactly)
# iOS: Create in App Store Connect → Your App → Subscriptions → add subscription, copy "Product ID"
# Android: Create in Google Play Console → Your App → Monetize → Subscriptions → copy "Product ID"
# Use the exact same Product ID strings here. If missing, you will get "SKU not found".
IAP_PRODUCT_ID_MONTHLY=your_monthly_subscription_product_id
IAP_PRODUCT_ID_YEARLY=your_yearly_subscription_product_id

# Instructions:
# 1. Go to https://cloud.appwrite.io and create a project
# 2. Copy your Project ID from the project settings
# 3. Create a database and collections (especially user_profiles)
# 4. Update your .env file with the actual IDs
# 5. Add APPWRITE_USER_PROFILES_COLLECTION_ID (REQUIRED for user sign up)
# 6. Restart your development server: npm start


# Your Appwrite Password Reset Function ID (required for password reset emails via Brevo)
APPWRITE_PASSWORD_RESET_FUNCTION_ID=your_password_reset_function_id_here

# Your Appwrite Magic URL Function ID (required for sign-in / email verification emails via Brevo)
APPWRITE_MAGIC_URL_FUNCTION_ID=your_magic_url_function_id_here
